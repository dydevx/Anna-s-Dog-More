# Public Supabase values. New projects should prefer publishable keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback name supported by the code during Supabase's key migration.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local: http://localhost:3000. Production: the exact public HTTPS origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CATALOG_FALLBACK_ENABLED=true

PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
# Local: signing secret from stripe listen. Production: endpoint signing secret.
# Subscribe to checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, charge.refunded.
STRIPE_WEBHOOK_SECRET=

# Optional transactional email adapter. Currently supported: resend.
EMAIL_PROVIDER=
EMAIL_API_KEY=
ORDER_FROM_EMAIL=
SHOP_ORDER_EMAIL=

# Prepared for prepayment by bank transfer. Leave blank until confirmed.
BANK_ACCOUNT_HOLDER=
BANK_IBAN=
BANK_BIC=

# Optional Upstash-compatible rate-limit store. In-memory limiting is development only.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
